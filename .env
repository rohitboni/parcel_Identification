# Database Configuration for Local Database (parcels_db_new)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=parcels_db_new
DB_USER=postgres
DB_PASSWORD=postgres

# Table Names (using local database tables)
TABLE_MASTER=parcels_master
TABLE_SIMPLIFIED=parcels_simplified

# Optional: Enable in-memory spatial index (only for small datasets <100K parcels)
# For large datasets, database-side queries are recommended (default)
ENABLE_IN_MEMORY_SPATIAL_INDEX=False
